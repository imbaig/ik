        "expect_nonempty": true,
        "expected_lookups": {
          "get_albums_by_artist": {
            "artist_name": "AC/DC"
          }
        }
      },
      {
        "text": "Show me tracks by that artist.",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "catalog"
        ],
        "required_tools": [
          "get_tracks_by_artist"
        ],
        "expect_nonempty": true,
        "expected_lookups": {
          "get_tracks_by_artist": {
            "artist_name": "AC/DC"
          }
        }
      }
