  {
    "id": "conv-12",
    "description": "Preference union and nonpreference question",
    "steps": [
      {
        "text": "Show my invoices.",
        "expected_status": [
          "waiting"
        ],
        "expected_branch": [
          "invoice"
        ],
        "expect_no_records": true,
        "expected_lookups": {}
      },
      {
        "text": "1",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "invoice"
        ],
        "expected_lookups": {}
      },
      {
        "text": "I love bebop. Remember that.",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "preference"
        ],
        "expected_lookups": {},
        "expected_preferences": [
          "bebop"
        ]
      },
      {
        "text": "I enjoy bluegrass.",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "preference"
        ],
        "expected_lookups": {},
        "expected_preferences": [
          "bebop",
          "bluegrass"
        ]
      },
      {
        "text": "Do you carry gospel?",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "catalog"
        ],
        "expected_lookups": {},
        "expected_preferences": [
          "bebop",
          "bluegrass"
        ]
      },
      {
        "text": "Which music preferences have I told you?",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "memory_recall"
        ],
        "must_contain": [
          "bebop",
          "bluegrass"
        ],
        "must_not_contain": [
          "gospel"
        ],
        "expected_lookups": {},
        "expected_preferences": [
          "bebop",
          "bluegrass"
        ]
      }
    ],
    "customer_id": 1,
    "tags": [
      "memory",
      "union",
      "question"
    ]
  },
  {
    "id": "conv-13",
    "description": "Memory isolation through reset",
    "steps": [
      {
        "text": "Show my invoices.",
        "expected_status": [
          "waiting"
        ],
        "expected_branch": [
          "invoice"
        ],
        "expect_no_records": true,
        "expected_lookups": {}
      },
      {
        "text": "1",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "invoice"
        ],
        "expected_lookups": {}
      },
      {
        "text": "I love shoegaze. Remember that.",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [],
        "expected_lookups": {},
        "expected_preferences": [
          "shoegaze"
        ]
      },
      {
        "expected_status": [
          "reset",
          "reset"
        ],
        "expected_branch": [],
        "action": "reset",
        "expected_lookups": {}
      },
      {
        "text": "Show my invoices.",
        "expected_status": [
          "waiting"
        ],
        "expected_branch": [
          "invoice"
        ],
        "expect_no_records": true,
        "expected_lookups": {}
      },
      {
        "text": "2",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "invoice"
        ],
        "oracle_customer_id": 2,
        "expected_lookups": {},
        "expected_preferences": []
      },
      {
        "text": "What music preferences have I told you?",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [],
        "must_not_contain": [
          "shoegaze"
        ],
        "oracle_customer_id": 2,
        "expected_lookups": {},
        "expected_preferences": []
      }
    ],
    "customer_id": 1,
    "tags": [
      "memory",
      "isolation",
      "reset"
    ]
  },
