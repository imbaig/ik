  {
    "id": "conv-01",
    "description": "Artist albums then contextual artist tracks",
    "steps": [
      {
        "text": "What albums by AC/DC do you carry?",
        "expected_status": [
          "complete"
        ],
        "expected_branch": [
          "catalog"
        ],
        "required_tools": [
          "get_albums_by_artist"
